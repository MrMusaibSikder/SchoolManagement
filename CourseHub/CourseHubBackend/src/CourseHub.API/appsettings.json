{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Authentication": {
    "Jwt": {
      "Issuer": "CourseHubBackend",
      "Audience": "CourseHubBackend",
      "SecretKey": "",
      "AccessTokenExpirationMinutes": 15,
      "RefreshTokenExpirationDays": 7
    },
    "PasswordReset": {
      "ExpirationMinutes": 60,
      "ResetUrlBase": "https://localhost/reset-password"
    }
  },
  "Seed": {
    "SuperAdminInviteCode": "",
    "DefaultRoles": [ "SuperAdmin", "Admin", "Teacher", "Student" ],
    "InstitutionName": "CourseHub Institute",
    "InstitutionSlug": "coursehub",
    "InstitutionDescription": "A course and training management platform."
  }
}
